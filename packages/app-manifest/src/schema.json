{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nimworld.local/schemas/app-manifest-v1.json",
  "title": "NimWorld App Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "name",
    "description",
    "category",
    "iconUrl",
    "launchUrl"
  ],
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "id": { "type": "string", "minLength": 1, "pattern": "^[a-z0-9-]+$" },
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "category": { "type": "string", "minLength": 1 },
    "iconUrl": { "type": "string", "minLength": 1 },
    "launchUrl": { "type": "string", "minLength": 1 },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "identity",
          "achievements",
          "stats",
          "leaderboards",
          "challenges",
          "inventory"
        ]
      }
    },
    "nimconnect": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "minimumSdkVersion": { "type": "string" },
        "requestedScopes": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "profile:read",
              "friends:read",
              "achievements:read",
              "inventory:read",
              "messages:summary",
              "payments:request"
            ]
          }
        }
      }
    },
    "world": {
      "type": "object",
      "additionalProperties": false,
      "required": ["locationType"],
      "properties": {
        "locationType": {
          "type": "string",
          "enum": [
            "fountain",
            "arena",
            "arcade",
            "town-hall",
            "social-club",
            "marketplace",
            "quest-board",
            "portal"
          ]
        },
        "district": { "type": "string" },
        "interactionLabel": { "type": "string" },
        "featured": { "type": "boolean" },
        "statusProvider": { "type": "string" }
      }
    },
    "extensions": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "$defs": {
    "Achievement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "appId",
        "achievementId",
        "title",
        "description"
      ],
      "properties": {
        "schemaVersion": { "type": "integer", "const": 1 },
        "appId": { "type": "string", "minLength": 1, "pattern": "^[a-z0-9-]+$" },
        "achievementId": { "type": "string", "minLength": 1, "pattern": "^[a-z0-9-]+$" },
        "title": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "iconUrl": { "type": "string", "minLength": 1 },
        "rarity": {
          "type": "string",
          "enum": ["common", "uncommon", "rare", "epic", "legendary"]
        },
        "unlockedAt": { "type": "string", "minLength": 1 },
        "progress": {
          "type": "object",
          "additionalProperties": false,
          "required": ["current", "target"],
          "properties": {
            "current": { "type": "number" },
            "target": { "type": "number" }
          }
        }
      }
    }
  }
}
